# Copy to .env (or export these directly) for local development.
# Never commit a real .env file - it's already in .gitignore.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=orderflow
DB_USERNAME=orderflow
DB_PASSWORD=orderflow

SERVER_PORT=8080

# Required - the app refuses to start without it. Generate with:
#   openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# Optional - only used once, on first startup with an empty users table, to
# create a single ADMIN account. Leave both unset to skip seeding entirely.
SEED_ADMIN=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
# How long a cached product stays in Redis before a natural re-fetch from MySQL.
PRODUCT_CACHE_TTL_SECONDS=300

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# How often OutboxRelay polls for unpublished events to send to Kafka.
OUTBOX_POLL_INTERVAL_MS=2000
